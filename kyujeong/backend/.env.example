DATABASE_URL="postgresql://user:password@localhost:5432/recipe_board"
JWT_SECRET="change-me"
PORT=3000

# Optional. If omitted, the AI MVP uses the local fallback recommender.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Minimum similarity required before a community post is used as AI evidence.
AI_RECOMMENDATION_MIN_SIMILARITY=0.55

# Minimum number of target ingredients that must appear in a community post.
AI_RECOMMENDATION_MIN_INGREDIENT_OVERLAP=1

# Public Data Portal food nutrition API for the food metadata MCP.
# Apply for the API key at data.go.kr and keep it server-side only.
PUBLIC_DATA_FOOD_API_KEY=""
PUBLIC_DATA_FOOD_API_URL="https://apis.data.go.kr/1471000/FoodNtrCpntDbInfo02/getFoodNtrCpntDbInq02"
PUBLIC_DATA_FOOD_API_TIMEOUT_MS=10000
